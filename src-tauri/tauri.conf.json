{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flightroom",
  "version": "../package.json",
  "identifier": "com.jaewon.flightroom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost gcimg: http://gcimg.localhost https://raw.githubusercontent.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: gcimg: http://gcimg.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "Jaewon",
    "shortDescription": "Photo culling, RAW developing and camera gear planner",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "startMenuFolder": ""
      }
    }
  }
}
